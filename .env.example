# ========================================================
# RHOAI Model Training Lab — Environment Configuration
# Copy to .env and fill in required values.
# ========================================================

# --- Model Configuration ---
BASE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
BASE_MODEL_REVISION=main
TOKENIZER_ID=Qwen/Qwen3-4B-Instruct-2507

# --- SDG Teacher Endpoint (authoring path only) ---
# Not required for learner training path
SDG_TEACHER_ENDPOINT=
SDG_TEACHER_API_KEY=
SDG_TEACHER_MODEL=

# --- User Simulator Endpoint (evaluation only) ---
# Not required for learner training path
USER_SIMULATOR_ENDPOINT=
USER_SIMULATOR_API_KEY=
USER_SIMULATOR_MODEL=

# --- Evaluation Judge Endpoint (evaluation only) ---
EVAL_JUDGE_ENDPOINT=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=

# --- S3-Compatible Storage ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rhoai-model-training-lab
S3_REGION=us-east-1
S3_USE_SSL=true
S3_CA_BUNDLE=

# --- MLflow ---
MLFLOW_TRACKING_URI=
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_EXPERIMENT_DATA=rhoai-model-training-lab-data
MLFLOW_EXPERIMENT_TRAINING=rhoai-model-training-lab-training
MLFLOW_EXPERIMENT_EVAL=rhoai-model-training-lab-evaluation

# --- Model Serving (RHOAI 3.5 vLLM) ---
BASE_SERVING_ENDPOINT=
LORA_SERVING_ENDPOINT=
OSFT_SERVING_ENDPOINT=
SERVING_CA_BUNDLE=
SERVING_TOKEN=

# --- Backend RAG Harness ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ENDPOINT=

# --- τ-bench Configuration ---
TAU_BENCH_VERSION=v1.0.1
TAU_BENCH_COMMIT_SHA=
TAU_BENCH_INSTALL_PATH=
